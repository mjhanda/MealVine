{
  "name": "mealapp",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-keep-awake": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-sharing": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "^10.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "validate": "jest src/data",
    "nutrition:build": "tsx scripts/build-nutrition.ts && prettier --write src/data/nutrition/nutritionData.ts",
    "build:dev": "npx eas-cli build --profile development --platform all",
    "build:preview": "npx eas-cli build --profile preview --platform all",
    "doctor": "npx expo-doctor",
    "e2e": "maestro test .maestro",
    "recipes:import": "tsx scripts/import-cmu/export-catalog.ts && python3 scripts/import-cmu/parse_archive.py && python3 scripts/import-cmu/build_recipes.py"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/reference/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/utils/**/*.ts",
      "src/store/**/*.ts",
      "!**/__tests__/**"
    ],
    "coverageThreshold": {
      "./src/utils/": {
        "lines": 80
      }
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
